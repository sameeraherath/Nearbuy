# Copy to supabase/.env for local development. Read by `supabase start` (config.toml env()).
SMS_PROVIDER=console
# Standard Webhooks secret for the Auth Send SMS hook: "v1,whsec_" + base64 (openssl rand -base64 32)
SEND_SMS_HOOK_SECRET=v1,whsec_REPLACE_ME
# Shared secret between the database (Vault: sms_dispatch_secret) and the sms-dispatch function
SMS_DISPATCH_SECRET=REPLACE_ME
# Phase 6 — Text.lk
TEXTLK_API_TOKEN=
TEXTLK_SENDER_ID=Nearbuy
