# Nearbuy environment variables. Each app gets its own .env (see README).
# Local values come from `pnpm supabase status`.

# --- Admin panel (apps/admin, Next.js) — Phase 2
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used to create rider auth users. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Customer app (apps/customer, Expo) — Phase 3
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Rider app (apps/rider, Expo) — Phase 5
# EXPO_PUBLIC_SUPABASE_URL / EXPO_PUBLIC_SUPABASE_ANON_KEY as above

# --- Supabase local dev + Edge Functions: see supabase/.env.example
